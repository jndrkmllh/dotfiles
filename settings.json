{
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
  "rubyLsp.enabledFeatures": {
    "codeActions": true,
    "diagnostics": true,
    "documentHighlights": true,
    "documentLink": true,
    "documentSymbols": true,
    "foldingRanges": true,
    "formatting": true,
    "hover": true,
    "inlayHint": true,
    "onTypeFormatting": true,
    "selectionRanges": true,
    "semanticHighlighting": true,
    "completion": true,
    "codeLens": true,
    "definition": true,
    "workspaceSymbol": true,
    "signatureHelp": true,
    "typeHierarchy": true
  },
  "rubyLsp.featuresConfiguration": {},
  "rubyLsp.formatter": "rubocop",
  "sorbet.enabled": true,
  "editor.autoIndentOnPaste": true,
  "editor.fontSize": 12,
  "editor.rulers": [120],
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.minimap.size": "fit",
  "editor.minimap.enabled": false,
  "window.zoomLevel": -1,
  "workbench.iconTheme": "vscode-great-icons",
  "todo-tree.general.showActivityBarBadge": true,
  "better-comments.highlightPlainText": true,
  "workbench.productIconTheme": "macos-modern",
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "git.autofetch": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.selectedCompletionModel": "",
  "git.confirmSync": false,
  "[ruby]": {
    "editor.defaultFormatter": "rubocop.vscode-rubocop"
  },
  "workbench.colorTheme": "LAST",
  "diffEditor.ignoreTrimWhitespace": false,
  "git.suggestSmartCommit": false,
  "chat.tools.terminal.autoApprove": {
    "bin/rails": true,
    "bin/rubocop": true
  },
  "git.ignoreRebaseWarning": true,
  "files.associations": {
    ".env*": "dotenv",
    "/config/*.key": "keys"
  },
  "github.copilot.enable": {
    "*": true,
    "dotenv": false,
    "keys": false
  },
  "claudeCode.preferredLocation": "panel",
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg"
}
